% Lines starting with % are comments and are ignored

% Vathapi Ganapathim Bhaje

% Tempo and Instrument
T160 I[ALTO_SAX] 

% All talas in their default jati are supported
% Tala names should be in lowercase
Tala=adi,4

% Raga names should be in lowercase
Raga=hamsadhwani,4

% A limited set of ragas are only supported. However using C12 notation
% all ragas can be coded. This is a hidden feature and might be removed in future.
% C12 - S r R g G m M P d D n N
% S P are case-insensitive


% empty measure to get prepared. z is for silence or rest. 
z32

% Set the octave to 5 and default length to 1

L=1 O=5

% As of now there are no measure markers
% Also it is not necessary to write one measure per line
% although this piece is written that way 
% I'd prefer keep the syntax simple so that the amount of learning
% required is minimal

G6 R4{gamaka:[[0,8],[0.32,0],[0.53,8],[0.78,0],[0.91,8],[1,0]]} R2                   S2 <N2{gamaka:[[0,5],[0.01,5],[0.29,5],[0.38,1],[0.57,5],[0.65,5],[0.79,1],[1,0]]}          P3{gamaka:[[0,17],[0.25,17],[0.42,15],[0.59,12],[0.73,7],[0.8,5],[0.93,0],[1,0]]} >R3{gamaka:[[0,-31],[0,-31],[0.43,8],[0.53,8],[0.59,0],[0.64,0],[0.74,8],[0.8,8],[0.89,5],[0.94,0],[0.97,0],[1,0]]} <N2{gamaka:[[0,14],[0.04,14],[0.2,0],[1,0]]} >R4{gamaka:[[0,-14],[0.2,8],[0.42,-9],[0.56,0],[1,0]]} S <N >S R
